# ==============================================================================
# Cortex AI Frontend — Environment Variables
# ==============================================================================
# Copy this file to .env.production.local and fill in your actual values.
# For local dev, use .env.local
#
# DO NOT commit real values — only this .env.example file.
# ==============================================================================

# Backend API URL (your deployed backend EC2/ECS URL or domain)
NEXT_PUBLIC_API_URL=https://api.your-domain.com

# WebSocket URL (if using live meeting captions via WebSocket)
NEXT_PUBLIC_WS_URL=wss://api.your-domain.com

# App Info
NEXT_PUBLIC_APP_NAME=Cortex AI
NEXT_PUBLIC_APP_URL=https://your-domain.com

# Slack OAuth (used for Slack Connect button in Settings)
NEXT_PUBLIC_SLACK_CLIENT_ID=your-slack-client-id
